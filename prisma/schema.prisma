// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  AUTHOR
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  image     String?
  role      Role     @default(ADMIN)
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Post {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  subtitle       String?
  excerpt        String
  content        String    @db.Text
  // SEO opcional: título e descrição próprios para o Google (se vazios, valem o título e o resumo)
  seoTitle       String?
  seoDescription String?
  coverImage     String
  tags           String[]  @default([])
  featured       Boolean   @default(false)
  published      Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  // Categoria opcional: ao excluir a categoria, o artigo fica sem categoria
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("posts")
}

// Categoria dos artigos do blog (um artigo tem no máximo uma)
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Course {
  id           String      @id @default(cuid())
  slug         String      @unique
  icon         String
  bgImage      String
  title        String
  text         String
  detail       String      @db.Text
  modalidade   String
  duracao      String
  local        String
  price        String
  whatsappLink String
  faqs         CourseFaq[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("courses")
}

model CourseFaq {
  id       String @id @default(cuid())
  question String
  answer   String @db.Text
  order    Int
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("course_faqs")
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  review     String   @db.Text
  order      Int
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("testimonials")
}

model Service {
  id           String @id @default(cuid())
  icon         String
  title        String
  text         String
  whatsappLink String
  order        Int

  @@map("services")
}

// Agenda de atendimentos em outras cidades
model AgendaEvent {
  id          String   @id @default(cuid())
  city        String
  state       String?
  venue       String
  address     String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  description String?  @db.Text
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("agenda_events")
}

// Banners publicitários exibidos no blog (um por posição, o primeiro ativo na ordem)
model Advertisement {
  id        String    @id @default(cuid())
  // Nome interno, só para identificar o banner no painel
  name      String
  // Onde aparece: BLOG_LIST ou POST_END (ver src/lib/ads/positions.ts)
  position  String
  imageUrl  String
  linkUrl   String
  altText   String
  active    Boolean   @default(true)
  // Janela opcional de exibição
  startsAt  DateTime?
  endsAt    DateTime?
  order     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position, active])
  @@map("advertisements")
}

// Configurações gerais do site: uma única linha (id "main"), criada no primeiro salvamento do admin
model SiteSettings {
  id                String   @id @default("main")
  whatsappNumber    String
  whatsappMessage   String
  email             String
  address           String
  instagramUrl      String   @default("")
  facebookUrl       String   @default("")
  xUrl              String   @default("")
  tiktokUrl         String   @default("")
  gtmId             String   @default("")
  gaId              String   @default("")
  metaPixelId       String   @default("")
  searchConsoleCode String   @default("")
  updatedAt         DateTime @updatedAt

  @@map("site_settings")
}
