GENERATE_SOURCEMAP=false

# Conexão usada pelo app (no Neon, a URL pooled)
DATABASE_URL=""
# Conexão direta para migrations e seed (no Neon, a URL sem pooler)
DIRECT_URL=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000/"

# E-mail com acesso ao painel admin
ADMIN_EMAIL=""

# Modo "Em construcao": true fecha o site (use so em Production na Vercel)
MAINTENANCE_MODE=

# Painel admin: upload de imagens no Cloudinary (parte de artigos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Pasta base das imagens enviadas pelo admin (padrão: devakaruno-web)
CLOUDINARY_FOLDER=devakaruno-web
